# =============================================================================
# event-invitation-platform — environment template
# Copy to .env (root) and to each app's .env as needed:
#   cp .env.example .env
# NEVER commit real secrets. NEVER expose backend secrets to the frontend.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# =============================================================================

# --- Database (PostgreSQL + Prisma) ---
# Used by: apps/api (NestJS) + prisma/
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_invitation?schema=public"

# --- Backend (NestJS API) ---
# Used by: apps/api
PORT=3001
API_PREFIX=api
# Comma-separated list of allowed origins for CORS (dev default allows Next.js)
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="change-me-in-real-env-min-32-chars"
NODE_ENV="development"

# --- Frontend (Next.js) ---
# Used by: apps/web
# Must point at the versioned backend API, e.g. http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# --- AI Service (FastAPI) ---
# Used by: apps/ai-service + apps/api (server-side calls to AI service)
AI_SERVICE_PORT=8000
# Internal URL the backend uses to reach the AI service (server-side only).
AI_SERVICE_URL="http://localhost:8000"
# Provider selection is intentionally NOT hard-coded to a vendor.
# Set to the provider name once chosen in a later phase (e.g. openai, anthropic, local...).
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
