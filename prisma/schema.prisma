// =============================================================================
// Prisma schema — AI-Powered Event Invitation Platform (Nvite).
//
// Implemented from the approved Database Structure (16 tables).
// - Model/field names are PascalCase/camelCase in code...
// - ...but mapped to the exact snake_case table/column names via @@map/@map.
// - UUID primary keys everywhere, per the structure.
// - created_at defaults to now(); updated_at uses @updatedAt (both NOT NULL).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  users User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid @map("role_id")
  firstName    String   @db.VarChar(100) @map("first_name")
  lastName     String   @db.VarChar(100) @map("last_name")
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.Text @map("password_hash")
  isActive     Boolean  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role          Role           @relation(fields: [roleId], references: [id])
  events        Event[]
  notifications Notification[]
  mediaAssets   MediaAsset[]
  aiUsage       AiUsage[]
  subscriptions Subscription[]

  @@map("users")
}

model Event {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid @map("user_id")
  title        String    @db.VarChar(255)
  eventType    String    @db.VarChar(100) @map("event_type")
  description  String?   @db.Text
  eventDate    DateTime  @db.Date @map("event_date")
  startTime    DateTime? @db.Time @map("start_time")
  endTime      DateTime? @db.Time @map("end_time")
  venueName    String?   @db.VarChar(255) @map("venue_name")
  venueAddress String?   @db.Text @map("venue_address")
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  invitation Invitation?

  @@map("events")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @db.Uuid @map("event_id")
  slug        String    @unique @db.VarChar(255)
  status      String    @db.VarChar(30)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event     Event               @relation(fields: [eventId], references: [id])
  designs   InvitationDesign[]
  guests    Guest[]
  media     MediaAsset[]
  aiUsage   AiUsage[]
  views     InvitationView[]

  @@map("invitations")
}

model InvitationDesign {
  id                  String   @id @default(uuid()) @db.Uuid
  invitationId        String   @db.Uuid @map("invitation_id")
  version             Int
  designSpecification Json     @db.JsonB @map("design_specification")
  sourceType          String   @db.VarChar(30) @map("source_type")
  isActive            Boolean  @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@unique([invitationId, version])
  @@map("invitation_designs")
}

model Guest {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @db.Uuid @map("invitation_id")
  name         String   @db.VarChar(255)
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  invitation Invitation @relation(fields: [invitationId], references: [id])
  rsvp       Rsvp?

  @@map("guests")
}

model Rsvp {
  id             String    @id @default(uuid()) @db.Uuid
  guestId        String    @unique @db.Uuid @map("guest_id")
  /// ATTENDING | NOT_ATTENDING | PENDING
  status         String    @db.VarChar(30)
  attendeesCount Int       @map("attendees_count")
  message        String?   @db.Text
  respondedAt    DateTime? @map("responded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id])

  @@map("rsvps")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  invitationId String   @db.Uuid @map("invitation_id")
  fileName     String   @db.VarChar(255) @map("file_name")
  fileUrl      String   @db.Text @map("file_url")
  fileType     String   @db.VarChar(100) @map("file_type")
  fileSize     BigInt   @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])
  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@map("media_assets")
}

model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  invitationId String   @db.Uuid @map("invitation_id")
  /// GENERATE_DESIGN | EDIT_DESIGN
  operationType String  @db.VarChar(50) @map("operation_type")
  status        String  @db.VarChar(30)
  tokensUsed    Int?    @map("tokens_used")
  createdAt     DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id])
  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@map("ai_usage")
}

model InvitationView {
  id                String   @id @default(uuid()) @db.Uuid
  invitationId      String   @db.Uuid @map("invitation_id")
  sessionIdentifier String?  @db.VarChar(255) @map("session_identifier")
  deviceType        String?  @db.VarChar(30) @map("device_type")
  country           String?  @db.VarChar(100)
  viewedAt          DateTime @default(now()) @map("viewed_at")

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@map("invitation_views")
}

model Plan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique @db.VarChar(100)
  description     String?  @db.Text
  price           Decimal  @db.Decimal(10, 2)
  billingInterval String   @db.VarChar(30) @map("billing_interval")
  isActive        Boolean  @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model Feature {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  description String? @db.Text

  planFeatures PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @db.Uuid @map("plan_id")
  featureId  String  @db.Uuid @map("feature_id")
  enabled    Boolean
  limitValue Int?    @map("limit_value")

  plan    Plan    @relation(fields: [planId], references: [id])
  feature Feature @relation(fields: [featureId], references: [id])

  @@unique([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  planId    String    @db.Uuid @map("plan_id")
  status    String    @db.VarChar(30)
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  autoRenew Boolean   @map("auto_renew")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                   String   @id @default(uuid()) @db.Uuid
  subscriptionId       String   @db.Uuid @map("subscription_id")
  amount               Decimal  @db.Decimal(10, 2)
  currency             String   @db.VarChar(10)
  status               String   @db.VarChar(30)
  transactionReference String?  @unique @db.VarChar(255) @map("transaction_reference")
  paymentDate          DateTime @map("payment_date")
  createdAt            DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}
